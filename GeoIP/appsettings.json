{
  "ServiceType": "API",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "Name": "RollingFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/geoip/geoip-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}",
    "CORS policy execution successful.",
    "Executing {ObjectResultType}, writing value of type '{Type}'."
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:55688"
      }
    }
  },
  //改走DB SiteConfig設定
  //"GeoIpSettings": {
  //  "WhitelistCsvFile": "IPInfo_WhiteList.csv",
  //  "ForbiddenCountries": ["CH","DE","DK","ES","FR","GB","HK","IL","MO","NL","NO","PH","PL","PT","SE","SG","TR","TW","US","VG","-"]
  //}
}
