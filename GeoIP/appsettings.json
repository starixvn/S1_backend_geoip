{
  "ServiceType": "API",
  "Serilog": {
    "Name": "RollingFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": [
        {
          "Name": "Microsoft", 
          "Level": "Information"
        },
        {
          "Name": "Microsoft.AspNetCore", 
          "Level": "Warning"
        }
      ]},
    "Path": "/geoip",
    "FileName": "geoip-api-.log",
    "FileSizeLimitBytes": 10485760,
    "RollOnFileSizeLimit": true,
    "RetainedFileCountLimit": null
  },
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:55688"
      }
    }
  },
  //改走DB SiteConfig設定
  //"GeoIpSettings": {
  //  "WhitelistCsvFile": "IPInfo_WhiteList.csv",
  //  "ForbiddenCountries": ["CH","DE","DK","ES","FR","GB","HK","IL","MO","NL","NO","PH","PL","PT","SE","SG","TR","TW","US","VG","-"]
  //}
}
